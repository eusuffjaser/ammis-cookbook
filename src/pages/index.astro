---
import RecipeApp from '../components/RecipeApp.jsx';
import recipeData from '../data/all_recipes.json';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Ammi's Recipes</title>
    <!-- Import the Google Fonts we used in the design -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:wght@400;500;600&family=Noto+Serif+Bengali:wght@400;500;600&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Pass your actual 150 recipes into the React app! -->
    <RecipeApp client:load initialRecipes={recipeData} />
  </body>
</html>